{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Liftr frontend plugin configuration",
  "type": "object",
  "properties": {
    "liftr": {
      "type": "object",
      "properties": {
        "auth": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": ["delegated", "passthrough", "insecure-development"],
              "description": "insecure-development suppresses the delegation header for loopback guest sessions.",
              "visibility": "frontend"
            }
          }
        },
        "ownerDisplay": {
          "type": "object",
          "description": "Presentation-only mapping of Liftr OwnerRef kinds to Backstage entity refs. Never affects authorization.",
          "visibility": "frontend",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "backstageKind": { "type": "string" },
              "namespace": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
