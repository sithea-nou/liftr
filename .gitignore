# Build output
/liftr-server
/liftr-migrate
/liftr-demo-server
/liftr-demo-tofu-server
/bin/
/dist/

# Local demo runtime state (examples/demo)
/.demo/

# Prebuilt Pulumi program binaries (registered programs require a digest;
# binaries are rebuilt from source, never committed)
internal/provisioning/pulumi/programs/*/program
internal/provisioning/pulumi/programs/*/dist/

# Test and coverage output
*.out
coverage.*

# Local configuration
.env
.env.*
!.env.example

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp

# Backstage integration (Node toolchain lives entirely under integrations/)
integrations/backstage/node_modules/
integrations/backstage/*/dist/
integrations/backstage/.yarn/*
!integrations/backstage/.yarn/patches
!integrations/backstage/.yarn/plugins
!integrations/backstage/.yarn/releases
integrations/backstage/.pnp.*
/node_modules/
/integrations/node_modules/
/integrations/backstage/*/*/*/dist/
/integrations/backstage/*/*/dist/
